def show_menu():
    """Show the list of lessons 1 to 7."""
    print("\n==============================")
    print("        LESSON MENU")
    print("==============================")
    for number in lessons:
        print(f"  {number}. {lessons[number]['title']}")
    print("  0. Exit")
    print("==============================")


def run_lesson(number):
    """Show one lesson, then ask its question."""
    lesson = lessons[number]


    print("\n------------------------------")
    print(f"Lesson {number}: {lesson['title']}")
    print("------------------------------")
    print(lesson["text"])

    input("Press Enter when you are ready for the question...")


    print("\nQUESTION:", lesson["question"], "\n")
    for letter, choice in lesson["choices"].items():
        print(f"  {letter}. {choice}")


    while True:
        answer = input("\nYour answer (A/B/C/D): ").strip().upper()
        if answer in lesson["choices"]:
            break
        print("Please type A, B, C or D only.")

    if answer == lesson["answer"]:
        print("Correct! Great job!")
    else:
        correct = lesson["answer"]
        print(f"Not quite. The correct answer is {correct}. {lesson['choices'][correct]}")


def main():
    while True:
        show_menu()
        choice = input("Choose a lesson (1-7) or 0 to exit: ").strip()

        if choice == "0":
            print("Goodbye! Keep learning!")
            break
        elif choice.isdigit() and int(choice) in lessons:
            run_lesson(int(choice))
            input("\nPress Enter to go back to the menu...")
        else:
            print("Invalid choice. Please type a number from 1 to 7.")


main()
